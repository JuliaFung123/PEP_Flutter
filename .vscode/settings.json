  "[dart]": {
    "editor.defaultFormatter": "Dart-Code.dart-code",
    "editor.tabSize": 2,
    "editor.rulers": [80]
  },
  "files.exclude": {
    "**/.dart_tool": true,
    "**/build": true
  }
}
